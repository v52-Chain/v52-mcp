{
  "name": "v52-mcp",
  "version": "1.2.0",
  "description": "Servidor MCP de Vector52 con investigaciones forenses pagadas mediante x402 en Avalanche Fuji.",
  "main": "dist/index.js",
  "bin": {
    "v52-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node -e \"try{require('fs').chmodSync('dist/index.js',0o755)}catch{}\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "test": "tsx --test test/**/*.test.ts",
    "dev": "tsx src/index.ts",
    "x402:demo": "tsx src/scripts/serve-x402-demo.ts",
    "x402:test": "tsx src/scripts/test-x402-avalanche.ts",
    "start": "node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v52-Chain/v52-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "avalanche",
    "vector52"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/v52-Chain/v52-mcp/issues"
  },
  "homepage": "https://github.com/v52-Chain/v52-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/fetch": "2.25.0",
    "dotenv": "17.2.3",
    "viem": "2.56.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
