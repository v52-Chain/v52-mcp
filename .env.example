# Only variable most people need. Without it, every free tool (saludar,
# estado_servidor, case_status, evidence_get, anchor_lookup, package_verify)
# still works — only vector52_wallet_flow / avalanche_x402_fetch (the tools
# that pay) require it. Use a funded Fuji DEVELOPMENT wallet. Never commit a
# real key.
X402_AGENT_PRIVATE_KEY=

# --- Everything below is optional: safe defaults are already baked in. ---

# Fuji RPC (defaults to Avalanche's public endpoint; override only if it's
# rate-limited or you want to use your own provider).
# AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Per-payment / per-process spending caps for x402 tools.
# X402_MAX_PAYMENT_USDC=0.05
# X402_MAX_SESSION_SPEND_USDC=0.10

# Extra HTTPS hosts avalanche_x402_fetch is allowed to pay (comma-separated).
# Empty by default: that tool can't reach anything outside the fixed Vector52 backend.
# X402_ALLOWED_HOSTS=

# Allows localhost as a payment target — only for the local x402 test fixture
# below; ignored when NODE_ENV=production.
# X402_ALLOW_LOCALHOST=false

# Writes x402 diagnostics to stderr (never stdout, which is reserved for the
# MCP JSON-RPC channel).
# X402_DEBUG=false

# --- Only needed to run `npm run x402:demo` / `npm run x402:test` (the local
# payment-flow test fixture) — never required by the MCP server or its tools.
# See docs/X402_AVALANCHE_TEST.md.
# X402_FACILITATOR_URL=https://facilitator.payai.network
# X402_MERCHANT_ADDRESS=
# X402_DEMO_URL=http://localhost:8080/demo/x402/premium-report
# X402_DEMO_PORT=8080
