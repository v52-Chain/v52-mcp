# Avalanche Fuji (testnet only)
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_CHAIN_ID=43113

# x402 (PayAI currently documents support for eip155:43113; change only after verifying another facilitator)
X402_NETWORK=eip155:43113
X402_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
X402_FACILITATOR_URL=https://facilitator.payai.network

# Agent wallet — use a funded Fuji development wallet. Never commit a real key.
X402_AGENT_PRIVATE_KEY=

# Merchant wallet that receives the test USDC payment
X402_MERCHANT_ADDRESS=

# Security controls
X402_MAX_PAYMENT_USDC=0.05
X402_MAX_SESSION_SPEND_USDC=0.10
X402_ALLOWED_HOSTS=
X402_ALLOW_LOCALHOST=false
X402_DEBUG=false

# Vector52 backend. La herramienta dedicada usa siempre este destino fijo.
V52_BACKEND_URL=https://v52-backend.onrender.com

# Local end-to-end test target (only for local development)
X402_DEMO_URL=http://localhost:8080/demo/x402/premium-report
